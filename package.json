{
  "name": "diloloji",
  "description": "Diloloji: Kişisel, adaptif dil öğrenme uygulaması (İngilizce, Fransızca, İspanyolca)",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "VITE_SUPABASE_URL=\"\" VITE_SUPABASE_PUBLISHABLE_KEY=\"\" VITE_SUPABASE_ANON_KEY=\"\" vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p tsconfig.api.json && tsc -p tsconfig.scripts.json && tsc -p tsconfig.worker.json",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "security": "npm run scan:secrets && npm run audit:deps",
    "build:ext": "node extension/build.mjs",
    "typecheck:ext": "tsc -p extension",
    "test:e2e": "VITE_SUPABASE_URL=\"\" VITE_SUPABASE_PUBLISHABLE_KEY=\"\" VITE_SUPABASE_ANON_KEY=\"\" vite build && playwright test && npm run test:e2e:gate",
    "test:e2e:gate": "VITE_SUPABASE_URL=https://gate.supabase.test VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_gate VITE_SUPABASE_ANON_KEY=\"\" vite build --outDir dist-gate && playwright test -c playwright.gate.config.ts",
    "build:cf": "npm run build && node scripts/cf-headers.mjs",
    "deploy:cf": "node scripts/check-deploy-env.mjs && npm run build:cf && wrangler deploy && node scripts/verify-deploy.mjs",
    "dev:cf": "npm run build:cf && wrangler dev",
    "verify:deploy": "node scripts/verify-deploy.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "@vercel/blob": "^2.8.0",
    "d3-force": "^3.0.0",
    "dexie": "^4.4.6",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js": "^1.14.2",
    "ts-fsrs": "^5.4.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@block65/webcrypto-web-push": "^2.0.0",
    "@cloudflare/workers-types": "^5.20261018.1",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sql.js": "^1.4.11",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "french-verbs": "^5.4.0",
    "french-verbs-lefff": "^3.4.0",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.63.0",
    "rolldown": "^1.2.12",
    "spanish-verbs": "^3.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.151.1"
  }
}
